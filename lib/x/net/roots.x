; net/roots.x -- Roots: the certificate authorities x's TLS client trusts.
;
; The roots are Mozilla's (lib/x/net/mozilla-roots.pem, regenerated by
; tools/roots/update.sh from NSS's certdata.txt).  Before each root the
; file carries its subject's DER bytes in hex, so a root is found by the
; issuer a certificate names with a search of the text, and only a match
; is parsed: a chain check reads one or two of the hundred-odd roots.
; The file is read once a process, on the first lookup.
(module x/net/roots)

(import x/codec/bytes)
(import x/sys/file)
(import x/net/x509)

(def %text (pair () ()))

(def %file (fn (_) (%module-resolve-file "x/net/mozilla-roots.pem")))

(def %load
  (fn (_)
    (when (null? (first %text))
      (do (def t (File read-all (%file)))
          (%set-first! %text (list t 0 (Str8 length t)))))
    (first %text)))

; The PEM block starting at or after offset at, as DER bytes.
(def %block-at
  (fn (_ text at)
    (def rest (Bytes sub text at (- (Bytes length text) at)))
    (def end (Bytes find rest "-----END CERTIFICATE-----"))
    (when (null? end) (Err raise (lit value) "Roots: a block with no end" at))
    (def pem (first (Bytes copy (Bytes sub rest 0 (+ end 25)))))
    (first (X509 from-pem pem))))

(def-class Roots ()
  (static
    (method find (self (param name ANY "A name's DER bytes, as a certificate's issuer gives it, a region"))
      (doc "The trusted roots whose subject is name, parsed (X509 parse), in the file's order; nil when no root has it."
        (returns LIST "Parsed certificates")
        (sample "(Roots find (X509 issuer cert))" "the roots that may have signed cert"))
      (def text (%load))
      (def key (Str8 append "# Subject: " (Bytes hex (Bytes of name)) "\n"))
      ((fn (self from acc)
         (def hit (Bytes find (Bytes sub text from (- (Bytes length text) from)) key))
         (if (null? hit) (List reverse acc)
           (do (def at (+ from hit (Str8 length key)))
               (self at (pair (X509 parse (%block-at text at)) acc)))))
       0 ()))
    (method count (self)
      (doc "How many roots the file holds."
        (returns INTEGER "The count")
        (sample "(Roots count)" "121"))
      (def text (%load))
      ((fn (self from n)
         (def hit (Bytes find (Bytes sub text from (- (Bytes length text) from)) "-----BEGIN CERTIFICATE-----"))
         (if (null? hit) n (self (+ from hit 27) (+ n 1))))
       0 0))))

(doc (provide x/net/roots Roots)
  "The certificate authorities x's TLS client trusts, Mozilla's: (Roots find name) answers the roots with that subject, parsed.")
