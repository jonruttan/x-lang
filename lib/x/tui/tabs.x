; tui/tabs.x -- windows in tabs, one shown, and the bar that lists them.
;
; Tabs hold windows (x/tui/window) in order and which one is current.  The
; bar is one row: each tab its number from 1 and its window's title, cut to
; share the row, the current tab bold and the rest reversed.  (Tabs draw)
; puts the bar on a row and the current window on the rows below it.

(module x/tui/tabs)
(import x/type/class)
(import x/type/vector)
(import x/codec/utf8 utf8-cp-at utf8-width)
(import x/tui/width char-width)
(import x/tui/style)
(import x/tui/screen)
(import x/tui/window)

(import x/core/doors int% int+ int/ int< obj-make obj-ref obj-set! str-byte-len str-byte-sub)
(def %tb-cvt (prim-ref (lit convert) (lit to)))
(def %tb-string (Type named STRING))
(def %tb-num (fn (_ n) (%tb-cvt n %tb-string 10)))
(def %tb-vector ((prim-ref (lit type) (lit of)) (Vector make 0 ())))
(def %tb-bar (Style make (lit (reverse)) () ()))
(def %tb-current (Style make (lit (bold)) () ()))

; Tabs are a vector: 0 the windows, in order, 1 the current one's index
; (-1 with none).
(def %tb-get (fn (_ t k) (obj-ref t (int+ k 1))))
(def %tb-put! (fn (_ t k x) (obj-set! t (int+ k 1) x)))
(def %tb-nth (fn (self k l) (match ((= k 0) (first l)) (#t (self (int+ k -1) (rest l))))))
(def %tb-drop (fn (self k l) (match ((= k 0) (rest l)) (#t (pair (first l) (self (int+ k -1) (rest l)))))))
(def %tb-count (fn (_ t) (%length (%tb-get t 0))))
; The bytes of S, from I, that fit in W columns: their end.
(def %tb-fit
  (fn (self s i w)
    (match ((= i (str-byte-len s)) i)
           ((int< w (char-width (utf8-cp-at s i))) i)
           (#t (self s (int+ i (utf8-width s i)) (int+ w (- 0 (char-width (utf8-cp-at s i)))))))))
(def %tb-cut (fn (_ s w) (str-byte-sub s 0 (%tb-fit s 0 w))))
(def %tb-draw-bar
  (fn (_ t screen row)
    (def cols (Screen cols screen))
    (def n (%tb-count t))
    (def each (match ((= n 0) cols) (#t (int/ cols n))))
    (Screen fill screen row 0 cols %tb-bar)
    ((fn (go ws k col)
       (match ((eq? ws ()) ())
              (#t (do (Screen put screen row col
                        (%tb-cut (%str-concat (list " " (%tb-num (int+ k 1)) " " (Window title (first ws)) " ")) each)
                        (match ((= k (%tb-get t 1)) %tb-current) (#t %tb-bar)))
                      (go (rest ws) (int+ k 1) (int+ col each))))))
     (%tb-get t 0) 0 0)))

(def-class Tabs ()
  (doc "Windows in tabs: their order, the one shown, and a bar listing them on one row."
    (example "(Tabs count (Tabs make))" "0")
    (see add) (see draw))
  (static
    (method make (self)
      (doc "No tabs." (returns VECTOR "The tabs")
        (example "(Tabs index (Tabs make))" "-1"))
      (def t (obj-make %tb-vector 3))
      (obj-set! t 0 2) (%tb-put! t 0 ()) (%tb-put! t 1 -1)
      t)
    (method add (self (param tabs VECTOR "Tabs") (param window VECTOR "A window (x/tui/window)"))
      (doc "Add WINDOW as the last tab and make it current: its index."
        (returns INTEGER "The new tab's index, from 0")
        (example "(Tabs add (Tabs make) (Window make \"t\" (Page text \"a\" 9)))" "0"))
      (%tb-put! tabs 0 (%reverse (pair window (%reverse (%tb-get tabs 0)))))
      (%tb-put! tabs 1 (int+ (%tb-count tabs) -1))
      (%tb-get tabs 1))
    (method count (self (param tabs VECTOR "Tabs"))
      (doc "How many tabs." (returns INTEGER "Tabs")
        (example "(Tabs count (Tabs make))" "0"))
      (%tb-count tabs))
    (method index (self (param tabs VECTOR "Tabs"))
      (doc "The current tab's index, -1 with none." (returns INTEGER "Index, from 0")
        (example "(Tabs index (Tabs make))" "-1"))
      (%tb-get tabs 1))
    (method current (self (param tabs VECTOR "Tabs"))
      (doc "The current tab's window, or nil with none." (returns ANY "A window or nil")
        (example "(Tabs current (Tabs make))" ""))
      (match ((int< (%tb-get tabs 1) 0) ()) (#t (%tb-nth (%tb-get tabs 1) (%tb-get tabs 0)))))
    (method window (self (param tabs VECTOR "Tabs") (param k INTEGER "Index, from 0"))
      (doc "Tab K's window." (returns VECTOR "A window")
        (example "(Window title (do (def t (Tabs make)) (Tabs add t (Window make \"t\" (Page text \"a\" 9))) (Tabs window t 0)))" "\"t\""))
      (%tb-nth k (%tb-get tabs 0)))
    (method select (self (param tabs VECTOR "Tabs") (param k INTEGER "Index, from 0"))
      (doc "Make tab K current, when there is one: the current index."
        (returns INTEGER "Index, from 0")
        (example "(Tabs select (Tabs make) 3)" "-1"))
      (match ((match ((int< k 0) #f) (#t (int< k (%tb-count tabs)))) (%tb-put! tabs 1 k)) (#t ()))
      (%tb-get tabs 1))
    (method next (self (param tabs VECTOR "Tabs"))
      (doc "Make the tab after the current one current, the first after the last: the current index."
        (returns INTEGER "Index, from 0")
        (example "(Tabs next (Tabs make))" "-1"))
      (match ((int< 0 (%tb-count tabs)) (%tb-put! tabs 1 (int% (int+ (%tb-get tabs 1) 1) (%tb-count tabs)))) (#t ()))
      (%tb-get tabs 1))
    (method prev (self (param tabs VECTOR "Tabs"))
      (doc "Make the tab before the current one current, the last before the first: the current index."
        (returns INTEGER "Index, from 0")
        (example "(Tabs prev (Tabs make))" "-1"))
      (match ((int< 0 (%tb-count tabs))
               (%tb-put! tabs 1 (int% (int+ (%tb-get tabs 1) (int+ (%tb-count tabs) -1)) (%tb-count tabs))))
             (#t ()))
      (%tb-get tabs 1))
    (method close (self (param tabs VECTOR "Tabs") (param k INTEGER "Index, from 0"))
      (doc "Close tab K: the tab after it becomes current if K was, or the one before when K was the last. The current index; -1 when none are left."
        (returns INTEGER "Index, from 0")
        (example "(do (def t (Tabs make)) (Tabs add t (Window make \"t\" (Page text \"a\" 9))) (Tabs close t 0))" "-1"))
      (match
        ((match ((int< k 0) #f) (#t (int< k (%tb-count tabs))))
          (do (%tb-put! tabs 0 (%tb-drop k (%tb-get tabs 0)))
              ((fn (_ cur n)
                 (%tb-put! tabs 1 (match ((int< k cur) (int+ cur -1))
                                         ((int< cur n) cur)
                                         (#t (int+ n -1)))))
               (%tb-get tabs 1) (%tb-count tabs))))
        (#t ()))
      (%tb-get tabs 1))
    (method draw-bar (self (param tabs VECTOR "Tabs") (param screen VECTOR "A screen (x/tui/screen)")
                           (param row INTEGER "The row to draw on"))
      (doc "Draw the tab bar on ROW of SCREEN: each tab its number and title, cut to an equal share of the row, the current one bold, the rest reversed."
        (returns ANY "nil")
        (example "(Tabs draw-bar (Tabs make) (Screen make 1 9) 0)" ""))
      (%tb-draw-bar tabs screen row))
    (method draw (self (param tabs VECTOR "Tabs") (param screen VECTOR "A screen (x/tui/screen)")
                       (param row INTEGER "The bar's row") (param rows INTEGER "Rows, the bar's with the window's"))
      (doc "Draw the tab bar on ROW of SCREEN and the current window on the ROWS - 1 rows below it."
        (returns ANY "nil")
        (example "(Tabs draw (Tabs make) (Screen make 3 9) 0 3)" ""))
      (%tb-draw-bar tabs screen row)
      (match ((int< (%tb-get tabs 1) 0)
               ((fn (go r) (match ((int< r (int+ row rows)) (do (Screen fill screen r 0 (Screen cols screen) 0) (go (int+ r 1))))
                                  (#t ())))
                (int+ row 1)))
             (#t (Window draw (self current tabs) screen (int+ row 1) (int+ rows -1))))
      ())))

(provide x/tui/tabs Tabs)
