# General Rules
# Taken from <https://github.com/github/gitignore/blob/master/C.gitignore>

# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# Project Specific Rules

# Editor files
*.sublime-*
*~

# Coverage reports
.coverage*/
*.gcov
*.gcda
*.gcno

# Scratchpad
tmp/
\#*

# Binaries
/x-bin
/x-bin-*
/core
*.core
docs/ref/x/
docs/ref/man/

# Agent / editor local state (Claude Code, etc.)
.claude/

# ctags output (regenerate locally with `ctags -R --exclude=docs/ref`)
tags
build/

# macOS finder metadata -- must be repo-local, not left to a contributor's
# global gitignore, or the first macOS clone commits one
.DS_Store

# The engine build's param declaration, copied up beside the binary by `make`.
# A per-BINARY fact, like the engine itself: never committed.
x-engine-build.xon

# ACQUIRED, NOT BUILT.  deps/ holds what this tree fetches from elsewhere --
# the engine (deps/engine/), its sources when a platform has no published
# artifact (deps/engine-src/), and lang bundles (deps/langs/).  None of it is
# produced here, which is why none of it is under build/: that directory is
# for output, and conflating the two is how `engine` came to need a symlink
# to be findable at all.  The PIN is committed; the bytes it names are not.
/deps/

# The engine link (Makefile: engine-link) -- points at the submodule, a
# checkout named by X_ENGINE_DIR, or an unpacked release.  Never committed.
/engine
