# General Rules
# Taken from <https://github.com/github/gitignore/blob/master/C.gitignore>

# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp
# ...but expect(1) scripts in the tty harness are SOURCE, not linker exports
!tests/logo-tty/*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# Project Specific Rules

# Editor files
*.sublime-*
*~

# Coverage reports
.coverage*/
*.gcov
*.gcda
*.gcno

# Scratchpad
tmp/
\#*

# Binaries
/x-bin
/x-bin-*
/core
*.core
docs/ref/c/
docs/ref/x/

# Agent / editor local state (Claude Code, etc.)
.claude/

# ctags output (regenerate locally with `ctags -R --exclude=docs/ref`)
tags
build/

# macOS finder metadata -- must be repo-local, not left to a contributor's
# global gitignore, or the first macOS clone commits one
.DS_Store

# Generated per build from `git describe` (Makefile: X_RELEASE); never committed.
include/x-release.h
