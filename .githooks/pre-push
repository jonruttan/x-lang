#!/bin/sh
# Pre-push gate -- block a push when the fast suite is red.
#
# Runs `make test-fast` (the fast scan gates + test-c + test-x), NOT
# the full `make test`: the full suite is too long to hold a push's SSH
# connection open across the hook -- GitHub hangs up the idle channel
# before the transfer starts.  CI remains the enforcing gate for the
# FULL surface: .github/workflows/ci.yml fans `make test`'s members out
# across parallel jobs (specs / gates / lint / docs / interactive) on
# every push and PR, with test-asan on merges to main (#330 corrected
# this note: ci.yml step-lists the members rather than invoking the
# `make test` umbrella).  Run `make test` locally when you want the
# whole thing in one command before pushing.  Install with
# `make install-hooks` (sets core.hooksPath=.githooks).  Bypass a
# single push with `git push --no-verify`.
#
# RUN_ASAN=1 additionally runs `make test-asan` as a NON-BLOCKING advisory.
# The baseline is clean and CI hard-gates it on merge to main; locally it
# stays opt-in only because instrumentation makes it ~2-3x slower.

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

# A deletion pushes the all-zeros SHA -- there is no new content to test.
# Skip the gate only when EVERY ref in this push is a deletion; a mixed
# push (delete + update) still gates on the updates.
any_update=
while read -r local_ref local_sha remote_ref remote_sha; do
	case "$local_sha" in
		*[!0]*) any_update=1 ;;
	esac
done
if [ -z "$any_update" ]; then
	printf '[pre-push] deletions only -- nothing to test, skipping gate.\n'
	exit 0
fi

# Hard gate: fast gates + both suites (test-c + test-x), green at HEAD.
printf '[pre-push] make test-fast ...\n'
if ! make test-fast; then
	printf '\n[pre-push] BLOCKED: `make test-fast` is red. Fix it, or bypass with `git push --no-verify`.\n' >&2
	exit 1
fi

# Opt-in ASan pass (see header note): non-blocking locally for speed; CI is
# the enforcing gate for this one.
if [ -n "$RUN_ASAN" ]; then
	printf '\n[pre-push] RUN_ASAN -- make test-asan (advisory) ...\n'
	make test-asan || printf '[pre-push] note: test-asan RED -- the baseline is clean, so this is likely YOUR regression (CI will hard-fail it); not blocking locally.\n' >&2
fi

printf '[pre-push] OK\n'
exit 0
