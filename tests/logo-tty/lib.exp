# lib.exp -- shared plumbing for the logo tty contract tests.
#
# Techniques (all proven in the #152/#162 verification sessions):
#   - stty_init sizes the pty; some line editors refuse a 0-width tty.
#   - liveness is asserted with COMPUTED output absent from the echo
#     (print 2 + 3 -> 5), never with echoed input.
#   - sends are paced: wait for each line's echo before continuing, so
#     a line-editing layer can never swallow machine-speed input.
#
# Every test exits 0 on pass, 1 on fail (the driver maps known-fail).

set stty_init "rows 40 columns 120"
# A CEILING FOR HANGS, NOT A STOPWATCH.  Every wait here is for a live
# interpreter to answer through a pty, and booting the logo entry from source
# costs ~4 seconds on an idle developer machine.  15 was therefore under 4x
# headroom, which is fine until the machine is a shared CI runner -- twice on
# macos-14 a cancel test failed for want of time (t05 once, t02 once, never the
# same one twice, never locally, never on Linux).
#
# Raising it costs nothing when the tests pass and delays only the report of a
# genuine hang.  X_TTY_TIMEOUT overrides it, which is also how the knob is
# tested: set it to 1 and every wait fails.
set timeout [expr {[info exists env(X_TTY_TIMEOUT)] ? $env(X_TTY_TIMEOUT) : 60}]

proc spawn_logo {} {
    global spawn_id spawn_pid env
    spawn sh x.sh -l logo
    # The pty makes the child a session leader, so its pid doubles as
    # the pgid of everything it forks -- including the viewer server
    # (which ignores SIGINT by design, but not SIGTERM).  Record it so
    # cleanup can kill exactly THIS tree: a machine-wide
    # pkill -f 'x-bin --batch' killed unrelated batch runs (#170).
    set spawn_pid [exp_pid]
    if {[info exists env(LOGO_TTY_PIDFILE)]} {
        set f [open $env(LOGO_TTY_PIDFILE) a]
        puts $f $spawn_pid
        close $f
    }
    expect {
        "localhost:8080" {}
        timeout { puts "FAIL: no banner"; exit 1 }
        eof { puts "FAIL: died at spawn"; exit 1 }
    }
    expect {
        -re {\? } {}
        timeout { puts "FAIL: no prompt"; exit 1 }
    }
}

# Kill this test's spawned session tree (TERM, then KILL) -- pgid-scoped,
# so concurrent batch engines elsewhere on the machine are untouched.
# Works even after wait reaped the leader: surviving members (an orphaned
# viewer server) keep the process group alive.
proc kill_session_tree {} {
    global spawn_pid
    if {![info exists spawn_pid]} { return }
    catch {exec kill -s TERM -- "-$spawn_pid"}
    # Condition wait, not a fixed second (#327): the group is usually
    # gone in milliseconds; the old 1s stays as the poll ceiling and
    # KILL as the unchanged backstop for a wedged tree.
    for {set i 0} {$i < 10} {incr i} {
        if {[catch {exec kill -0 -- "-$spawn_pid"}]} { return }
        after 100
    }
    catch {exec kill -s KILL -- "-$spawn_pid"}
}

# Send a line and wait for its echo (pacing).
proc send_line {text} {
    send "$text\r"
    expect {
        -ex $text {}
        timeout { puts "FAIL: line never echoed: $text"; exit 1 }
    }
}

# Assert the session evaluates: expect computed output not in any echo.
proc assert_alive {a b sum} {
    send "print $a + $b\r"
    expect {
        -ex $sum { }
        eof { puts "FAIL: session dead"; exit 1 }
        timeout { puts "FAIL: no evaluation"; exit 1 }
    }
    expect {
        -re {\? } {}
        timeout { puts "FAIL: no prompt after eval"; exit 1 }
    }
}

proc ctrl_c {} { send "\x03" }
proc ctrl_d {} { send "\x04" }

# True when something is listening on :8080 (the viewer server).
# lsof on macOS; ss fallback on minimal Linux runners.
proc port_8080_busy {} {
    if {![catch {exec lsof -nP -i :8080} out] && [string length $out] > 0} {
        return 1
    }
    if {![catch {exec sh -c "ss -ltn 2>/dev/null | grep ':8080 '"} out2]
            && [string length $out2] > 0} {
        return 1
    }
    return 0
}

# True when the spawned process exited NORMALLY with status 0.  expect's
# wait reports signal death differently across OSes (Linux appends
# CHILDKILLED with status 0 in slot 3) -- a plain slot-3 test lies there.
proc exited_zero {result} {
    if {[lsearch -exact $result CHILDKILLED] >= 0} { return 0 }
    return [expr {[lindex $result 2] == 0 && [lindex $result 3] == 0}]
}
