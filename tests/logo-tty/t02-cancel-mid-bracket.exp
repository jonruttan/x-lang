#!/usr/bin/expect -f
# Behaviors 1+2+3+5: ctrl-c mid-entry cancels the pending input and the
# session SURVIVES -- the handler is installed mid-entry (1), the pending
# block is discarded (2), the #90 filein latch is un-poisoned (3), and the
# fd-3 tty reclaim survives the signal (5).
# `print [a` is mid-entry under both eras: open bracket depth today,
# inside the LOGO-OPEN reader loop after the rewrite.
source [file join [file dirname [info script]] lib.exp]
spawn_logo
# Brace-quoted: [ ] is Tcl command substitution inside double quotes.
send {print [a}
send "\r"
# The echo IS the entry-arrived signal (the file's own pacing rule);
# a fixed second here was pure ceiling (#327).
expect {
    -ex {print [a} {}
    timeout { puts "FAIL: entry never echoed"; exit 1 }
}
ctrl_c
# The cancel lands the session back at a prompt; that prompt is the
# processed-the-interrupt signal the old sleep approximated.
expect {
    -re {\? } {}
    timeout { puts "FAIL: no prompt after cancel"; exit 1 }
}
# The discarded entry must produce no output; the session must evaluate.
assert_alive 7 6 13
ctrl_d
expect eof
exit 0
