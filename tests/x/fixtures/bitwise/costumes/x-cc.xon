; x-cc's bitwise.xon, frozen: the parity specs must not depend on a
; sibling checkout being present, or on its costume staying still.

(costume "x-cc"
  (logo "the C logo's blue")
  (accent 206 100 31)
  (rows "., .," "{OvO}" "( C )" " \" \"")
  (roles "ii ii" "ieifi" "i a i" " i i ")
  (reference "puts(\"{O,O}\");"))
