# doctest-split.awk -- split the generated doctest spec into one spec file
# per library area.
#
#   awk -v dir=build/doctest-specs -f tools/check/doctest-split.awk SPEC
#
# SPEC is what tools/check/doctest.sh prints: a title, then one `## ` section
# per module (`## boot surface` first, `## census` last).  Each section goes to
# the file for its area, the module path's first two parts: x/codec/json goes
# to doctests-x-codec.spec.md, the boot surface to doctests-boot.spec.md.  The
# census is prose and goes to no file, and neither does a section that holds
# no example.
#
# A file's examples import the modules they belong to, so a file loads its own
# area and not the whole library: its time follows the area's size.
#
# Each file declares `# @timeout-scale 1`.  The budget is the base one; the
# declaration is there because the runner gives a file that carries it a
# process of its own.

function area(section,    parts, n) {
	if (section == "boot surface")
		return "boot"
	n = split(section, parts, "/")
	if (n < 2)
		return parts[1]
	return parts[1] "-" parts[2]
}

/^## / {
	section = substr($0, 4)
	out = ""
	pending = (section == "census") ? "" : $0
	next
}

# A section with no examples is left out, so an area that has none gets no
# file: the heading waits for the section's first test.
/^### / && pending != "" {
	out = dir "/doctests-" area(section) ".spec.md"
	if (!(out in seen)) {
		seen[out] = 1
		printf "# Doctests, %s -- GENERATED by tools/check/doctest.x (#16); do not edit\n", area(section) > out
		print "# @timeout-scale 1" > out
	}
	print "" > out
	print pending > out
	print "" > out
	pending = ""
}

/^### / && out != "" { written++ }

section == "census" && /^emitted: / { emitted = $2 + 0 }

out != "" { print > out }

# The census counts the examples the walk emitted; the files must hold as
# many, or a section went to no file.
END {
	if (written != emitted) {
		printf "doctest-split: FAIL -- %d examples written, the census says %d\n", written, emitted > "/dev/stderr"
		exit 1
	}
}
