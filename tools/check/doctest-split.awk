# doctest-split.awk -- split the generated doctest spec into one spec file
# per module.
#
#   awk -v dir=build/doctest-specs -f tools/check/doctest-split.awk SPEC
#
# SPEC is what tools/check/doctest.sh prints: a title, then one `## ` section
# per module (`## boot surface` first, `## census` last).  Each section goes to
# the file named for its module, the path's parts joined by dashes: x/codec/json
# goes to doctests-x-codec-json.spec.md, the boot surface to
# doctests-boot.spec.md.  The census is prose and goes to no file, and neither
# does a section that holds no example.
#
# A file's examples import the module they belong to, so a file loads that
# module and what it imports, not its neighbours.  The runner collects before
# every case, and a collect's cost follows what is loaded, so a file's time
# follows its own module's size.
#
# Each file declares `# @timeout-scale 1`.  The budget is the base one; the
# declaration is there because the runner gives a file that carries it a
# process of its own, where files sharing a process would keep each other's
# modules loaded.
#
# One file is open at a time: there are a few hundred, more than an awk can
# hold open at once.

function name(section) {
	if (section == "boot surface")
		return "boot"
	gsub("/", "-", section)
	return section
}

/^## / {
	if (out != "")
		close(out)
	section = substr($0, 4)
	out = ""
	pending = (section == "census") ? "" : $0
	next
}

# A section with no examples is left out, so a module that has none gets no
# file: the heading waits for the section's first test.
/^### / && pending != "" {
	out = dir "/doctests-" name(section) ".spec.md"
	if (!(out in seen)) {
		seen[out] = 1
		printf "# Doctests, %s -- GENERATED by tools/check/doctest.x (#16); do not edit\n", name(section) > out
		print "# @timeout-scale 1" > out
		close(out)
	}
	print "" >> out
	print pending >> out
	print "" >> out
	pending = ""
}

/^### / && out != "" { written++ }

section == "census" && /^emitted: / { emitted = $2 + 0 }

out != "" { print >> out }

# The census counts the examples the walk emitted; the files must hold as
# many, or a section went to no file.
END {
	if (written != emitted) {
		printf "doctest-split: FAIL -- %d examples written, the census says %d\n", written, emitted > "/dev/stderr"
		exit 1
	}
}
