; doctest.x -- extract (example ...) forms from the doc registry into a
; generated spec file for the standard harness (#16).
;
; Run via tools/check/doctest.sh: x-core + this file on stdin, the module list
; (import paths like x/type/dict) on argv. Emits a .spec.md on stdout.
;
; Attribution: modules are imported one at a time and the doc registry (a
; prepend-only list) is diffed around each import, so the new entries belong to
; that module.  Entries already present after boot (x-core's own docs) need no
; import line in their generated tests.
;
; The import is emitted as its own top-level form ahead of the example, never
; wrapped in one (do ...) with it: a tower literal inside the same top-level
; form as the import that defines its reader misparses, since parsing precedes
; evaluation.
;
; An example with an empty expected string is illustrative only -- counted and
; skipped, not emitted.  Every other example is emitted verbatim; the harness
; verdict buckets them.

; Fetch the string prim from the catalogue (ns `str` is de-registered, R5).
(def %str->sym (prim-ref 'str '->sym))

(def %emit (fn (_ s) (do (display s "\n"))))

; Walk the registry from head until the remembered older head; returns
; the new entries oldest-first (registration order).
(def %new-entries
  (fn (_ head stop)
    (def %go
      (fn (self lst acc)
        (if (null? lst) acc
          (if (eq? lst stop) acc
            (self (rest lst) (pair (first lst) acc))))))
    (%go head ())))

; --- Census counters ---
(def %n-emitted (pair 0 ()))
(def %n-blank (pair 0 ()))
(def %n-samples (pair 0 ()))
(def %fail-imports (pair () ()))
(def %count! (fn (_ cell) (%set-first! cell (+ (first cell) 1))))

; --- The help-example tally (tools/check/help-examples.sh) ---
; help renders an entry's examples and samples alike, so an entry with
; either shows the reader one; the entries with neither are the count that
; check holds to its ceiling.  Of those, a module is keyed under its own
; name and a method under Class/method; both hold a slash, so the module
; registry is asked first, and what is left is a bare def or primitive.
; An entry documented twice is walked twice and counted twice; help shows
; the newer one.
;
; The tally also keeps every def entry, under def-names, as (NAME MODULE):
; MODULE the import the walk met the entry under, () for the boot surface.
; The trailer looks each NAME up once every module is loaded; see "Documented
; defs nothing binds" below.
(def %help-tally
  (list (pair 'entries 0) (pair 'example 0) (pair 'sample-only 0)
        (pair 'method 0) (pair 'def 0) (pair 'module 0) (pair 'def-names ())))
(def %tally (fn (_ key) (List find (fn (_ c) (eq? (first c) key)) %help-tally)))
(def %tally! (fn (_ key) (def c (%tally key)) (%set-rest! c (+ (rest c) 1))))

(def %tally-entry!
  (fn (_ e mod)
    (def name (%doc-entry-name e))
    (def group
      (match
        ((not (null? (%module-lookup name))) 'module)
        ((%doc-str-contains? "/" (symbol->str name)) 'method)
        (#t 'def)))
    (when (eq? group 'def)
      (let ((c (%tally 'def-names)))
        (%set-rest! c (pair (list name (if mod (%str->sym mod) ())) (rest c)))))
    (%tally! 'entries)
    (match
      ((not (null? (%doc-entry-examples e))) (%tally! 'example))
      ((not (null? (%doc-entry-samples e))) (%tally! 'sample-only))
      (#t (%tally! group)))))

; Emit one example as a harness test. mod is the import path string, or
; nil for boot-registered names.
(def %emit-example
  (fn (_ name mod in out idx)
    (if (str=? out "")
      (%count! %n-blank)
      (do
        (%count! %n-emitted)
        (%emit "")
        (display "### " (symbol->str name) " -- example " idx "\n")
        (%emit "")
        (%emit "```scheme")
        (when mod
          (do (display "(import " mod) (%emit ")")))
        (%emit in)
        (%emit "```")
        (%emit "---")
        (display "    ") (%emit out)))))

; Emit every example carried by the given registry entries.
(def %emit-entries
  (fn (_ entries mod)
    (List for-each
      (fn (_ e)
        (%tally-entry! e mod)
        (let ((name (%doc-entry-name e)))
          (def %go
            (fn (self exs idx)
              (unless (null? exs)
                (do
                  (%emit-example name mod (first (first exs)) (rest (first exs)) idx)
                  (self (rest exs) (+ idx 1))))))
          (%go (%doc-entry-examples e) 1)
          (def %count-samples
            (fn (self ss)
              (unless (null? ss)
                (do (%count! %n-samples) (self (rest ss))))))
          (%count-samples (%doc-entry-samples e))))
      entries)))

; --- Generation ---

; The spec is not run as one file: a process that ran it would load every
; documented module on its way through the examples.  `make doctest` cuts it
; by library area (tools/check/doctest-split.awk), one section to a `## `
; heading, and each file loads its own area.
(%emit "# Doctests -- GENERATED by tools/check/doctest.x (#16); do not edit")

; Boot surface: everything the x-core boot registered.
(%doc-commit!)
(def %boot-head (first %doc-registry-cell))
(%emit "")
(%emit "## boot surface")
(%emit-entries (%new-entries %boot-head ()) ())

; Each module from argv, one import at a time.
(List for-each
  (fn (_ m)
    (def %before (first %doc-registry-cell))
    (def %ok (pair #t ()))
    (guard (err
        (do (%set-first! %ok #f)
            (%set-first! %fail-imports (pair m (first %fail-imports)))))
      (eval! (list 'import (%str->sym m))))
    (when (first %ok)
      (do
        (%doc-commit!)
        (let ((new (%new-entries (first %doc-registry-cell) %before)))
          (unless (null? new)
            (do
              (%emit "")
              (display "## ") (%emit m)
              (%emit-entries new m)))))))
  (rest args))  ; args[0] is the interpreter binary path

; --- Census trailer (prose section; the harness ignores it) ---
(%emit "")
(%emit "## census")
(%emit "")
(display "emitted: " (first %n-emitted) "\n"
         "blank-expected (illustrative, skipped): " (first %n-blank) "\n"
         "samples (illustrative by contract, not run): " (first %n-samples)
         "\n" "entries: " (rest (%tally 'entries))
         "\n" "with example: " (rest (%tally 'example))
         "\n" "with sample only: " (rest (%tally 'sample-only))
         "\n" "without example or sample: "
         (+ (rest (%tally 'method)) (+ (rest (%tally 'def)) (rest (%tally 'module))))
         " (methods " (rest (%tally 'method))
         ", defs " (rest (%tally 'def))
         ", modules " (rest (%tally 'module)) ")"
         "\n" "failed imports: ")
(write (first %fail-imports)) (newline)

; --- Documented defs nothing binds (tools/check/help-examples.sh) ---
; A def entry names a binding, and once the binding is retired -- made
; %-private, or deleted -- the entry documents nothing, while help and the
; generated reference go on showing it.  A NAME the tally kept is bound when
; the root binds it, or when a module's provide list names it and the
; module's own environment binds it: a scoped module's exports live in its
; environment, a child of the root, and a selective import reads them from
; there.  A private a scoped module binds and does not provide is reachable
; by no reader of help, so its entry counts as unbound.  The walk's MODULE
; is not always the file that wrote the entry -- an import loads what it
; imports, and the boot loads scoped modules too -- so the lookup does not
; start from it.
(import x/type/module)
(import x/type/env)
(let ()
  (def same-obj? (prim-ref 'obj 'same?))
  (def no-binding (pair () ()))
  (def bound-in?
    (fn (_ name env)
      (not (same-obj? no-binding (guard (_ no-binding) (eval name env))))))
  ; (ENV . EXPORTS) for each loaded module that provides a name.
  (def provides
    (List map (fn (_ m) (pair (Module env m) (Module exports m)))
      (List filter
        (fn (_ m) (if (Module loaded? m) (not (null? (Module exports m))) #f))
        (Module names))))
  (def def-bound?
    (fn (_ name)
      (if (bound-in? name (Env root)) #t
        (List any?
          (fn (_ p) (if (List includes? name (rest p)) (bound-in? name (first p)) #f))
          provides))))
  (display "unbound defs: ")
  (write (List reverse
    (List filter (fn (_ d) (not (def-bound? (first d)))) (rest (%tally 'def-names)))))
  (newline))
